{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "static",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://pasuk-leshem.onrender.com/api/:path*" }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
